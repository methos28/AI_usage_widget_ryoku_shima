{
    "name": "AI usage",
    "icon": "neurology",
    "version": "1.0",
    "author": "MeThOs",
    "description": "Agentic AI usage on the Island: live sessions, tokens for the chosen period, top models and an activity heatmap, straight from the shared usage caches.",
    "category": "system",
    "main": "AiUsageTile.qml",
    "iris": {
        "main": "IrisCompact.qml",
        "slots": [
            "island.desktop"
        ]
    },
    "defaultConfig": {
        "placementStrategy": "free",
        "widgetScale": 100,
        "widgetOpacity": 100,
        "colorMode": "auto",
        "dim": 0,
        "x": 240,
        "y": 240
    },
    "configKeys": {
        "tool": {
            "type": "string",
            "default": "opencode",
            "label": "Which agent it watches",
            "options": [
                {
                    "label": "OpenCode",
                    "value": "opencode"
                },
                {
                    "label": "Claude Code",
                    "value": "claude"
                },
                {
                    "label": "Codex",
                    "value": "codex"
                }
            ]
        },
        "moduleWidth": {
            "type": "int",
            "default": 480,
            "min": 280,
            "max": 600,
            "label": "Card width"
        },
        "topModels": {
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 3,
            "label": "Top models to list"
        },
        "period": {
            "type": "string",
            "default": "30",
            "label": "Trend period",
            "options": [
                {
                    "label": "Today",
                    "value": "today"
                },
                {
                    "label": "Last 24 hours",
                    "value": "24h"
                },
                {
                    "label": "Last 7 days",
                    "value": "7"
                },
                {
                    "label": "Last 30 days",
                    "value": "30"
                },
                {
                    "label": "All time",
                    "value": "all"
                }
            ]
        }
    },
    "resizableAxes": {
        "uniform": "widgetScale"
    },
    "defaultSize": {
        "width": 380,
        "height": 420
    }
}
