{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "HANDOFF-CODEX.md",
    "memory/current-state.md"
  ],
  "lsp": {
    "qml": {
      "command": [
        "python3",
        "tools/lsp.py",
        "qml"
      ],
      "extensions": [
        ".qml"
      ]
    },
    "python": {
      "command": [
        "python3",
        "tools/lsp.py",
        "python"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "json": {
      "command": [
        "python3",
        "tools/lsp.py",
        "json"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "bash": {
      "command": [
        "python3",
        "tools/lsp.py",
        "bash"
      ],
      "extensions": [
        ".sh",
        ".bash"
      ]
    }
  }
}
